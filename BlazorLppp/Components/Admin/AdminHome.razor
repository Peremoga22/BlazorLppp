@page "/admin-home"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Admin)]

@using BlazorLppp.Application.Models
@using BlazorLppp.Domain
@using Microsoft.AspNetCore.Authorization

@inject ITestAttemptService TestAttemptService
@inject IJSRuntime JsRuntime

<PageTitle>Адмін-панель</PageTitle>

<div class="admin-page">
    <header class="admin-page__header admin-page__header--hero">
        <div class="admin-page__hero-copy">
            <p class="admin-page__eyebrow">Психологічне тестування</p>
            <h1 class="admin-page__title">Адмін-панель</h1>
            <p class="admin-page__subtitle">
                @(_selectedUnit is null
                    ? "Загальний огляд усіх підрозділів"
                    : $"Підрозділ {_selectedUnit}: спроби та результати працівників")
            </p>
        </div>
        <div class="admin-page__hero-meta" aria-hidden="true">
            <span class="admin-page__hero-chip">
                @(_selectedUnit is null ? "Усі відділи" : $"Відділ {_selectedUnit}")
            </span>
        </div>
    </header>

    <div class="admin-tabs" role="tablist" aria-label="Підрозділи">
        <button type="button"
                class="admin-tabs__item admin-tabs__item--admin @(_selectedUnit is null ? "admin-tabs__item--active" : null)"
                role="tab"
                aria-selected="@(_selectedUnit is null)"
                @onclick="() => SelectTabAsync(null)">
            <span class="admin-tabs__icon" aria-hidden="true">◆</span>
            <span class="admin-tabs__text">
                <span class="admin-tabs__label">Адмін</span>
                <span class="admin-tabs__hint">загальний огляд</span>
            </span>
        </button>
        @foreach (var unit in UnitNumbers.All)
        {
            <button type="button"
                    class="admin-tabs__item @(_selectedUnit == unit ? "admin-tabs__item--active" : null)"
                    role="tab"
                    aria-selected="@(_selectedUnit == unit)"
                    @onclick="() => SelectTabAsync(unit)">
                <span class="admin-tabs__num" aria-hidden="true">@unit</span>
                <span class="admin-tabs__text">
                    <span class="admin-tabs__label">Підрозділ</span>
                    <span class="admin-tabs__hint">відділ @unit</span>
                </span>
            </button>
        }
    </div>

    @if (_isLoading)
    {
        <p class="admin-page__muted">Завантаження...</p>
    }
    else if (!string.IsNullOrEmpty(_errorMessage) && _stats is null)
    {
        <p class="admin-page__error" role="alert">@_errorMessage</p>
    }
    else
    {
        @if (_stats is not null)
        {
            <div class="admin-stats">
                <div class="admin-stats__item admin-stats__item--accent">
                    <span class="admin-stats__value">@_stats.PeopleCompleted</span>
                    <span class="admin-stats__label">
                        @(_selectedUnit is null ? "Пройшли тести (усі)" : "Пройшли тести")
                    </span>
                </div>
                <div class="admin-stats__item">
                    <span class="admin-stats__value">@_stats.InProgress</span>
                    <span class="admin-stats__label">В процесі</span>
                </div>
                <div class="admin-stats__item">
                    <span class="admin-stats__value">@_stats.Completed</span>
                    <span class="admin-stats__label">Завершені</span>
                </div>
                <div class="admin-stats__item">
                    <span class="admin-stats__value">@_stats.StartedToday</span>
                    <span class="admin-stats__label">Сьогодні</span>
                </div>
            </div>

            <div class="admin-page__actions admin-actions">
                <a class="admin-btn admin-btn--soft" href="/admin/attempts">
                    <span class="admin-btn__icon admin-btn__icon--list" aria-hidden="true"></span>
                    Список спроб
                </a>
                <a class="admin-btn admin-btn--soft" href="/admin/documents">
                    <span class="admin-btn__icon admin-btn__icon--file" aria-hidden="true"></span>
                    Документи / тести
                </a>
            </div>
        }

        <section class="admin-home-results" aria-labelledby="results-heading">
            <header class="admin-home-results__header">
                <div>
                    <h2 id="results-heading" class="admin-upload__title">Результати тестів</h2>
                    <p class="admin-page__muted">
                        @(_selectedUnit is null
                            ? "Завершені тести по всіх підрозділах. Файли: «Прізвище_І_П.docx»"
                            : $"Завершені тести підрозділу {_selectedUnit}. Файли: «Прізвище_І_П.docx»")
                    </p>
                </div>
                @if (_results.Count > 0)
                {
                    <a class="admin-btn"
                       href="@DownloadAllHref"
                       title="Зібрати всі результати в один Word-документ і завантажити">
                        <span class="admin-btn__icon admin-btn__icon--download" aria-hidden="true"></span>
                        Завантажити всі в один документ
                    </a>
                }
            </header>

            @if (!string.IsNullOrEmpty(_resultsError))
            {
                <p class="admin-page__error" role="alert">@_resultsError</p>
            }
            else if (_results.Count == 0)
            {
                <p class="admin-page__muted">Завершених тестів ще немає.</p>
            }
            else
            {
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Працівник</th>
                                <th>Тест</th>
                                <th>Підрозділ</th>
                                <th>Файл</th>
                                <th>Завершено</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _results)
                            {
                                <tr>
                                    <td>@item.DisplayName</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.TestTitle) ? "—" : item.TestTitle)</td>
                                    <td>@item.NumberUnit</td>
                                    <td>
                                        @if (item.HasResultFile)
                                        {
                                            <code>@item.ResultFileName</code>
                                        }
                                        else
                                        {
                                            <span class="admin-page__muted">не сформовано</span>
                                        }
                                    </td>
                                    <td>@(item.CompletedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                    <td>
                                        <div class="admin-actions admin-actions--icons">
                                            <a class="admin-icon-btn"
                                               href="@($"/admin/results/{item.AttemptId}")"
                                               title="Деталі"
                                               aria-label="Деталі">
                                                <span class="admin-btn__icon admin-btn__icon--eye" aria-hidden="true"></span>
                                            </a>
                                            @if (item.HasResultFile)
                                            {
                                                <a class="admin-icon-btn admin-icon-btn--download"
                                                   href="@($"/admin/results/{item.AttemptId}/download")"
                                                   title="Завантажити"
                                                   aria-label="Завантажити">
                                                    <span class="admin-btn__icon admin-btn__icon--download" aria-hidden="true"></span>
                                                </a>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="admin-icon-btn admin-icon-btn--secondary"
                                                        title="Сформувати файл"
                                                        aria-label="Сформувати файл"
                                                        @onclick="() => GenerateAsync(item.AttemptId)">
                                                    <span class="admin-btn__icon admin-btn__icon--file" aria-hidden="true"></span>
                                                </button>
                                            }
                                            <button type="button"
                                                    class="admin-icon-btn admin-icon-btn--danger"
                                                    title="Видалити"
                                                    aria-label="Видалити"
                                                    disabled="@_isDeleting"
                                                    @onclick="() => DeleteAsync(item)">
                                                <span class="admin-btn__icon admin-btn__icon--trash" aria-hidden="true"></span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@code {
    private int? _selectedUnit;
    private TestAttemptStats? _stats;
    private readonly List<TestResultListItem> _results = [];
    private bool _isLoading = true;
    private bool _isDeleting;
    private string? _errorMessage;
    private string? _resultsError;

    private string DownloadAllHref =>
        _selectedUnit is null
            ? "/admin/results/download-all"
            : $"/admin/results/download-all?numberUnit={_selectedUnit.Value}";

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            await RefreshDataAsync();
        }
        catch (Exception)
        {
            _errorMessage = "Не вдалося завантажити дані панелі.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectTabAsync(int? unit)
    {
        if (_selectedUnit == unit)
        {
            return;
        }

        _selectedUnit = unit;
        _isLoading = true;
        _errorMessage = null;
        _resultsError = null;
        StateHasChanged();

        try
        {
            await RefreshDataAsync();
        }
        catch (Exception)
        {
            _errorMessage = "Не вдалося завантажити дані вкладки.";
            _stats = null;
            _results.Clear();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshDataAsync()
    {
        var statsTask = TestAttemptService.GetStatsAsync(_selectedUnit);
        var resultsTask = TestAttemptService.GetCompletedResultsAsync(_selectedUnit);
        await Task.WhenAll(statsTask, resultsTask);

        _stats = await statsTask;
        _results.Clear();
        _results.AddRange(await resultsTask);
        _errorMessage = null;
    }

    private async Task GenerateAsync(Guid attemptId)
    {
        try
        {
            await TestAttemptService.EnsureResultFileAsync(attemptId);
            var items = await TestAttemptService.GetCompletedResultsAsync(_selectedUnit);
            _results.Clear();
            _results.AddRange(items);
            _resultsError = null;
        }
        catch (Exception ex)
        {
            _resultsError = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося сформувати файл."
                : ex.Message;
        }
    }

    private async Task DeleteAsync(TestResultListItem item)
    {
        if (_isDeleting)
        {
            return;
        }

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Видалити результат «{item.DisplayName}» разом із файлом на сервері?");

        if (!confirmed)
        {
            return;
        }

        _isDeleting = true;
        _resultsError = null;

        try
        {
            await TestAttemptService.DeleteAsync(item.AttemptId);
            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            _resultsError = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося видалити результат."
                : ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
