@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        var returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var loginUrl = NavigationManager.GetUriWithQueryParameters(
            "Account/Login",
            new Dictionary<string, object?> { ["returnUrl"] = returnUrl });

        // GetUriWithQueryParameters may return an absolute URL; convert to a rooted local path.
        if (Uri.TryCreate(loginUrl, UriKind.Absolute, out var absolute))
        {
            loginUrl = absolute.PathAndQuery;
        }
        else if (!loginUrl.StartsWith('/'))
        {
            loginUrl = "/" + loginUrl;
        }

        NavigationManager.NavigateTo(loginUrl, forceLoad: true);
    }
}
