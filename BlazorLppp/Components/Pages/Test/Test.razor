@page "/test/{AttemptId:guid}"
@rendermode InteractiveServer
@attribute [AllowAnonymous]

@using BlazorLppp.Application.Models
@using BlazorLppp.Domain.Enums
@using Microsoft.AspNetCore.Authorization

@inject ITestAttemptService TestAttemptService

<PageTitle>Тестування</PageTitle>

<div class="test-page">
    <div class="test-page__card test-page__card--form">
        @if (_isLoading)
        {
            <p class="test-page__text">Завантаження...</p>
        }
        else if (!string.IsNullOrEmpty(_errorMessage) && _form is null)
        {
            <h1 class="test-page__title">Помилка</h1>
            <p class="test-page__text">@_errorMessage</p>
            <a class="test-page__link" href="/">До стартової сторінки</a>
        }
        else if (_form is null)
        {
            <h1 class="test-page__title">Спробу не знайдено</h1>
            <p class="test-page__text">Перевірте посилання або почніть тестування знову.</p>
            <a class="test-page__link" href="/">До стартової сторінки</a>
        }
        else
        {
            <header class="test-form__header">
                <h1 class="test-page__title">@_form.TestTitle</h1>
                <p class="test-page__name">@_form.RespondentName</p>
                @if (!IsZbroyaForm(_form) && !string.IsNullOrWhiteSpace(_form.Instruction))
                {
                    <p class="test-page__text test-form__instruction">@_form.Instruction</p>
                }
            </header>

            @if (_form.IsCompleted)
            {
                <p class="test-form__done">Дякуємо! Ваші відповіді збережено.</p>
                <a class="test-page__link" href="/">На головну</a>
            }
            else
            {
                <EditForm Model="_form" OnValidSubmit="SubmitAsync">
                    @{
                        var isZbroyaForm = IsZbroyaForm(_form);
                        var ratingQuestions = isZbroyaForm
                            ? _form.Questions.Where(q => q.SortOrder is >= 1 and <= 20).ToList()
                            : [];
                        var sanQuestions = isZbroyaForm
                            ? _form.Questions.Where(q => q.SortOrder is >= 21 and <= 23).ToList()
                            : [];
                        var otherQuestions = isZbroyaForm
                            ? _form.Questions.Where(q => q.SortOrder > 23).ToList()
                            : _form.Questions.ToList();
                    }

                    @if (isZbroyaForm && ratingQuestions.Count > 0)
                    {
                        <p class="test-form__intro">
                            Пропонуємо Вам перевірити свою готовність до несення служби зі зброєю в добовому наряді.
                            Ваші правдиві і відверті відповіді сприятимуть прийняттю об’єктивного рішення про допуск Вас
                            до виконання зазначених завдань.
                        </p>

                        <p class="test-form__section-title">1. Інструкція</p>
                        <div class="test-form__legend" aria-hidden="true">
                            <span><strong>1</strong> — Ні, це не так</span>
                            <span><strong>2</strong> — Мабуть так</span>
                            <span><strong>3</strong> — Правильно</span>
                            <span><strong>4</strong> — Абсолютно правильно</span>
                        </div>

                        <ol class="test-form__list test-form__list--zbroya">
                            @foreach (var question in ratingQuestions)
                            {
                                <li class="test-form__question test-form__question--compact">
                                    <div class="test-form__question-text">
                                        <span class="test-form__number">@question.SortOrder.</span>
                                        @question.Text
                                    </div>
                                    <div class="test-form__scale test-form__scale--rating" role="radiogroup" aria-label="@question.Text">
                                        @foreach (var option in question.Options.OrderBy(o => o.Key))
                                        {
                                            <label class="test-form__scale-item" title="@option.Text">
                                                <input type="radio"
                                                       name="@($"q-{question.Id}")"
                                                       checked="@(question.SelectedOptionId == option.Id)"
                                                       @onchange="() => question.SelectedOptionId = option.Id" />
                                                <span>@(string.IsNullOrWhiteSpace(option.Key) ? option.Text : option.Key)</span>
                                            </label>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>

                        <p class="test-form__section-title">
                            2. Поставте позначку на шкалі, яка відповідає інтенсивності вияву зазначених чинників:
                        </p>

                        <ol class="test-form__list test-form__list--san">
                            @foreach (var question in sanQuestions)
                            {
                                var title = ZbroyaSanTitle(question.SortOrder, question.Text);
                                <li class="test-form__question test-form__question--san">
                                    <div class="test-form__san-title">@title</div>
                                    <div class="test-form__analog" role="radiogroup" aria-label="@title">
                                        @for (var value = 0; value <= 10; value++)
                                        {
                                            var scaleValue = value;
                                            var label = value switch
                                            {
                                                0 => "0%",
                                                5 => "50",
                                                10 => "100%",
                                                _ => $"{value * 10}"
                                            };
                                            <label class="test-form__analog-item @(question.ScaleValue == scaleValue ? "is-selected" : null)"
                                                   title="@($"{value * 10}%")">
                                                <input type="radio"
                                                       name="@($"q-scale-{question.Id}")"
                                                       checked="@(question.ScaleValue == scaleValue)"
                                                       @onchange="() => question.ScaleValue = scaleValue" />
                                                <span>@label</span>
                                            </label>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    }

                    <ol class="test-form__list">
                        @foreach (var question in otherQuestions)
                        {
                            <li class="test-form__question">
                                <div class="test-form__question-text">
                                    @if (isZbroyaForm && question.SortOrder == 24)
                                    {
                                        <span>Чи згодні Ви із зазначеним висловом?</span>
                                    }
                                    else
                                    {
                                        @if (!isZbroyaForm)
                                        {
                                            <span class="test-form__number">@question.SortOrder.</span>
                                        }
                                        <span class="test-form__statement-text">@question.Text</span>
                                    }
                                </div>

                                @if (isZbroyaForm && question.SortOrder == 24)
                                {
                                    <p class="test-form__hint test-form__statement">@question.Text</p>
                                }
                                else if (!string.IsNullOrWhiteSpace(question.Hint))
                                {
                                    <p class="test-form__hint">@question.Hint</p>
                                }

                                @if (question.Type is QuestionType.SingleChoice or QuestionType.YesNo)
                                {
                                    <div class="test-form__options" role="radiogroup" aria-label="@question.Text">
                                        @foreach (var option in question.Options)
                                        {
                                            <label class="test-form__option">
                                                <input type="radio"
                                                       name="@($"q-{question.Id}")"
                                                       checked="@(question.SelectedOptionId == option.Id)"
                                                       @onchange="() => question.SelectedOptionId = option.Id" />
                                                <span>
                                                    @if (!string.IsNullOrWhiteSpace(option.Key) &&
                                                         option.Key is not ("Так" or "Ні"))
                                                    {
                                                        <strong>@option.Key.</strong>
                                                    }
                                                    @option.Text
                                                </span>
                                            </label>
                                        }
                                    </div>
                                }
                                else if (question.Type == QuestionType.Scale)
                                {
                                    var min = question.ScaleMin ?? 1;
                                    var max = question.ScaleMax ?? 10;
                                    <div class="test-form__scale"
                                         role="radiogroup"
                                         aria-label="@question.Text">
                                        @for (var value = min; value <= max; value++)
                                        {
                                            var scaleValue = value;
                                            <label class="test-form__scale-item">
                                                <input type="radio"
                                                       name="@($"q-scale-{question.Id}")"
                                                       checked="@(question.ScaleValue == scaleValue)"
                                                       @onchange="() => question.ScaleValue = scaleValue" />
                                                <span>@scaleValue</span>
                                            </label>
                                        }
                                    </div>
                                }
                            </li>
                        }
                    </ol>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <p class="test-form__error" role="alert">@_errorMessage</p>
                    }

                    <button type="submit"
                            class="test-form__submit"
                            disabled="@_isSubmitting">
                        @(_isSubmitting ? "Збереження..." : "Завершити тест")
                    </button>
                </EditForm>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid AttemptId { get; set; }

    private TestFormModel? _form;
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _form = await TestAttemptService.GetFormAsync(AttemptId);
        }
        catch (Exception ex)
        {
            _form = null;
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося завантажити форму тесту."
                : ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_form is null || _isSubmitting || _form.IsCompleted)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var answers = _form.Questions.Select(q => new TestAnswerInput
            {
                QuestionId = q.Id,
                SelectedOptionId = q.SelectedOptionId,
                ScaleValue = q.ScaleValue
            }).ToList();

            await TestAttemptService.SubmitAsync(AttemptId, answers);
            _form = await TestAttemptService.GetFormAsync(AttemptId);
        }
        catch (Exception ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося зберегти відповіді."
                : ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static bool IsZbroyaForm(TestFormModel form)
    {
        if (form.TestTitle.Contains("ЗБРОЯ", StringComparison.OrdinalIgnoreCase) ||
            form.TestTitle.Contains("зброя", StringComparison.OrdinalIgnoreCase) ||
            (form.Instruction?.Contains("ПОЧУВАЄТЕСЯ ЦІЄЇ МИТІ", StringComparison.OrdinalIgnoreCase) ?? false))
        {
            return true;
        }

        return form.Questions.Count >= 20 &&
               form.Questions.Any(q =>
                   q.SortOrder == 1 &&
                   q.Text.StartsWith("Я спокійний", StringComparison.OrdinalIgnoreCase));
    }

    private static string ZbroyaSanTitle(int sortOrder, string fallback) => sortOrder switch
    {
        21 => "САМОПОЧУТТЯ",
        22 => "АКТИВНІСТЬ",
        23 => "НАСТРІЙ",
        _ => fallback
    };
}
