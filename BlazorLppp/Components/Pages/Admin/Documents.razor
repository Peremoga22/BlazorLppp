@page "/admin/documents"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Admin)]

@using BlazorLppp.Application.Models
@using BlazorLppp.Domain
@using BlazorLppp.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options

@inject IDocumentStorageService DocumentStorageService
@inject ITestDefinitionService TestDefinitionService
@inject IOptions<DocumentStorageOptions> DocumentStorageOptions
@inject IJSRuntime JsRuntime

<PageTitle>Документи</PageTitle>

<div class="admin-page">
    <header class="admin-page__header">
        <div class="admin-page__header-row">
            <div>
                <h1 class="admin-page__title">Документи тесту</h1>
                <p class="admin-page__subtitle">
                    Завантажте .docx/.doc/.txt — система зчитає питання і сформує вебформу для працівників
                </p>
            </div>
            <a class="admin-link admin-link--back" href="/admin-home">
                <span class="admin-btn__icon admin-btn__icon--arrow-left" aria-hidden="true"></span>
                До панелі
            </a>
        </div>
    </header>

    <section class="admin-upload" aria-labelledby="upload-heading">
        <h2 id="upload-heading" class="admin-upload__title">Завантаження</h2>
        <p class="admin-page__muted">
            Для авторозбору потрібен .docx, .doc або .txt. Максимум @_maxSizeMb МБ.
        </p>

        <div class="admin-upload__row">
            <InputFile class="admin-upload__input"
                       OnChange="OnFileSelectedAsync"
                       accept=".docx,.txt,.pdf,.doc" />
            <button type="button"
                    class="admin-btn"
                    disabled="@(!_canUpload || _isUploading)"
                    @onclick="UploadAsync">
                <span class="admin-btn__icon admin-btn__icon--upload" aria-hidden="true"></span>
                @(_isUploading ? "Обробка..." : "Завантажити та розібрати")
            </button>
        </div>

        @if (_selectedFile is not null)
        {
            <p class="admin-upload__selected">
                Обрано: <strong>@_selectedFile.Name</strong>
                (@FormatSize(_selectedFile.Size))
            </p>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <p class="admin-upload__success" role="status">@_successMessage</p>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="admin-page__error" role="alert">@_errorMessage</p>
        }
    </section>

    <section class="admin-upload-list" aria-labelledby="documents-heading">
        <h2 id="documents-heading" class="admin-upload__title">Розібрані тести</h2>

        @if (_isLoading)
        {
            <p class="admin-page__muted">Завантаження списку...</p>
        }
        else if (_testDocuments.Count == 0)
        {
            <p class="admin-page__muted">Ще немає активних тестів. Завантажте документ.</p>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Назва</th>
                            <th>Файл</th>
                            <th>Питань</th>
                            <th>Статус</th>
                            <th>Завантажено</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in _testDocuments)
                        {
                            <tr>
                                <td>@doc.Title</td>
                                <td>@doc.OriginalFileName</td>
                                <td>@doc.Questions.Count</td>
                                <td>
                                    @if (doc.IsActive)
                                    {
                                        <span class="admin-badge admin-badge--done">Активний</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge--progress">Неактивний</span>
                                    }
                                </td>
                                <td>@doc.UploadedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <div class="admin-actions admin-actions--icons">
                                        <button type="button"
                                                class="admin-icon-btn"
                                                title="Перегляд"
                                                aria-label="Перегляд"
                                                @onclick="() => PreviewAsync(doc.Id)">
                                            <span class="admin-btn__icon admin-btn__icon--eye" aria-hidden="true"></span>
                                        </button>
                                        @if (!doc.IsActive)
                                        {
                                            <button type="button"
                                                    class="admin-icon-btn"
                                                    title="Зробити активним"
                                                    aria-label="Зробити активним"
                                                    @onclick="() => ActivateAsync(doc.Id)">
                                                <span class="admin-btn__icon admin-btn__icon--check" aria-hidden="true"></span>
                                            </button>
                                        }
                                        <button type="button"
                                                class="admin-icon-btn admin-icon-btn--danger"
                                                title="Видалити"
                                                aria-label="Видалити"
                                                disabled="@_isDeleting"
                                                @onclick="() => DeleteAsync(doc)">
                                            <span class="admin-btn__icon admin-btn__icon--trash" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (_preview is not null)
    {
        <section class="admin-upload-list" aria-labelledby="preview-heading">
            <div class="admin-page__header-row">
                <h2 id="preview-heading" class="admin-upload__title">Попередній перегляд: @_preview.Title</h2>
                <button type="button"
                        class="admin-btn admin-btn--ghost admin-btn--sm"
                        @onclick="HidePreview">
                    Сховати
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_preview.Instruction))
            {
                <p class="admin-page__muted">@_preview.Instruction</p>
            }

            <ol class="admin-preview-list">
                @foreach (var question in _preview.Questions.OrderBy(q => q.SortOrder))
                {
                    <li class="admin-preview-item">
                        <strong>@question.Text</strong>
                        @if (!string.IsNullOrWhiteSpace(question.Hint))
                        {
                            <div class="admin-page__muted">@question.Hint</div>
                        }
                        @if (question.Options.Count > 0)
                        {
                            <ul>
                                @foreach (var option in question.Options.OrderBy(o => o.SortOrder))
                                {
                                    <li>@option.Key. @option.Text</li>
                                }
                            </ul>
                        }
                        else if (question.Type == Domain.Enums.QuestionType.Scale)
                        {
                            <div class="admin-page__muted">
                                Шкала: @question.ScaleMin – @question.ScaleMax
                            </div>
                        }
                    </li>
                }
            </ol>
        </section>
    }
</div>

@code {
    private readonly List<TestDocument> _testDocuments = [];
    private TestDocument? _preview;
    private IBrowserFile? _selectedFile;
    private bool _isLoading = true;
    private bool _isUploading;
    private bool _isDeleting;
    private bool _canUpload;
    private string? _errorMessage;
    private string? _successMessage;
    private long _maxSizeMb;

    protected override async Task OnInitializedAsync()
    {
        _maxSizeMb = Math.Max(1, DocumentStorageOptions.Value.MaxFileSizeBytes / (1024 * 1024));
        await ReloadListAsync();
    }

    private Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        _errorMessage = null;
        _successMessage = null;
        _selectedFile = args.FileCount > 0 ? args.File : null;
        _canUpload = _selectedFile is not null;
        return Task.CompletedTask;
    }

    private async Task UploadAsync()
    {
        if (_selectedFile is null || _isUploading)
        {
            return;
        }

        _isUploading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var upload = await DocumentStorageService.UploadAsync(_selectedFile);
            var document = await TestDefinitionService.ImportUploadedDocumentAsync(
                upload,
                upload.AbsolutePath);

            _successMessage =
                $"Документ оброблено: «{document.Title}». Знайдено питань: {document.Questions.Count}. Тест активовано.";
            _selectedFile = null;
            _canUpload = false;
            _preview = null;
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося завантажити або розібрати документ."
                : ex.Message;
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task ActivateAsync(Guid documentId)
    {
        try
        {
            await TestDefinitionService.SetActiveAsync(documentId);
            _successMessage = "Тест активовано для проходження працівниками.";
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task DeleteAsync(TestDocument document)
    {
        if (_isDeleting)
        {
            return;
        }

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Видалити документ «{document.Title}» разом із файлом на сервері та пов’язаними спробами?");

        if (!confirmed)
        {
            return;
        }

        _isDeleting = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await TestDefinitionService.DeleteAsync(document.Id);
            if (_preview?.Id == document.Id)
            {
                _preview = null;
            }

            _successMessage = $"Документ «{document.Title}» і файл на сервері видалено.";
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося видалити документ."
                : ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task PreviewAsync(Guid documentId)
    {
        if (_preview?.Id == documentId)
        {
            HidePreview();
            return;
        }

        _preview = await TestDefinitionService.GetByIdAsync(documentId);
    }

    private void HidePreview() => _preview = null;

    private async Task ReloadListAsync()
    {
        _isLoading = true;
        try
        {
            var items = await TestDefinitionService.ListAsync();
            _testDocuments.Clear();
            _testDocuments.AddRange(items);

            if (_preview is not null)
            {
                _preview = items.FirstOrDefault(d => d.Id == _preview.Id);
            }
        }
        catch (Exception)
        {
            _errorMessage = "Не вдалося завантажити список документів.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} Б";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024d:0.#} КБ";
        }

        return $"{bytes / (1024d * 1024d):0.#} МБ";
    }
}
