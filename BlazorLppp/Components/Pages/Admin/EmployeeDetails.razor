@page "/admin/employees/{EmployeeId:guid}"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Admin)]

@using BlazorLppp.Application.Models
@using BlazorLppp.Domain
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@inject IOrganizationService OrganizationService
@inject ITestAttemptService TestAttemptService
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<PageTitle>@_card?.Employee.DisplayName ?? "Працівник"</PageTitle>

<div class="admin-page">
    @if (_isLoading)
    {
        <p class="admin-page__muted">Завантаження...</p>
    }
    else if (_card is null)
    {
        <p class="admin-page__error">Працівника не знайдено.</p>
        <a class="admin-page__link" href="/admin/departments">До підрозділів</a>
    }
    else
    {
        <header class="admin-page__header admin-page__header--hero">
            <div class="admin-page__hero-copy">
                <p class="admin-page__eyebrow">
                    <a href="/admin/departments">Підрозділи</a>
                    ·
                    <a href="@($"/admin/departments/{_card.Department.Id}")">@_card.Department.Name</a>
                </p>
                <h1 class="admin-page__title">@_card.Employee.DisplayName</h1>
                <p class="admin-page__subtitle">Підрозділ: @_card.Department.Name</p>
            </div>
            <div class="admin-page__actions admin-actions">
                <button type="button"
                        class="admin-btn admin-btn--danger"
                        disabled="@_isDeleting"
                        @onclick="DeleteEmployeeAsync">
                    Видалити працівника
                </button>
            </div>
        </header>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="admin-page__error">@_errorMessage</p>
        }

        <section class="admin-panel">
            <h2 class="admin-upload__title">Психологічні тести</h2>
            @if (_card.TestTabs.Count == 0)
            {
                <p class="admin-empty">Цей працівник ще не проходив тести.</p>
            }
            else
            {
                <div class="test-tabs" role="tablist">
                    @foreach (var tab in _card.TestTabs)
                    {
                        <button type="button"
                                class="test-tabs__item @(_selectedTestId == tab.TestDocumentId ? "test-tabs__item--active" : null)"
                                @onclick="() => SelectTestAsync(tab.TestDocumentId)">
                            @tab.TestTitle
                            <span class="test-tabs__count">@tab.SessionCount</span>
                        </button>
                    }
                </div>
            }
        </section>

        <section class="admin-panel">
            <h2 class="admin-upload__title">
                @(_selectedTestTitle ?? "Історія проходжень")
            </h2>

            @if (_card.Sessions.Count == 0)
            {
                <p class="admin-page__muted">Немає проходжень для обраного тесту.</p>
            }
            else
            {
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Дата</th>
                                <th>Результат</th>
                                <th>Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in _card.Sessions)
                            {
                                <tr>
                                    <td>@((session.CompletedAt ?? session.StartedAt).ToString("dd.MM.yyyy HH:mm"))</td>
                                    <td>@session.StatusName</td>
                                    <td class="admin-table__actions">
                                        <a class="admin-link" href="@($"/admin/results/{session.AttemptId}")">Відкрити</a>
                                        @if (session.IsCompleted)
                                        {
                                            <ResultDownloadLink AttemptId="session.AttemptId"
                                                                CssClass="admin-link"
                                                                Title="Завантажити документ">
                                                Документ
                                            </ResultDownloadLink>
                                        }
                                        <button type="button"
                                                class="admin-icon-btn admin-icon-btn--danger"
                                                title="Видалити проходження"
                                                aria-label="Видалити проходження"
                                                disabled="@_isDeleting"
                                                @onclick="() => DeleteSessionAsync(session)">
                                            <span class="admin-btn__icon admin-btn__icon--trash" aria-hidden="true"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="admin-page__actions admin-actions" style="margin-top:1rem">
                @if (_selectedTestId.HasValue && _card.Sessions.Count(s => s.IsCompleted) >= 2)
                {
                    <a class="admin-btn"
                       href="@($"/admin/analytics/employees/{EmployeeId}?test={_selectedTestId}")">
                        Динаміка →
                    </a>
                }
                <a class="admin-btn admin-btn--soft"
                   href="@($"/admin/departments/{_card.Department.Id}")">
                    ← Назад на один крок
                </a>
                <a class="admin-btn admin-btn--soft" href="/admin/departments">
                    ←← Ще на крок назад
                </a>
            </div>
        </section>
    }
</div>

@code {
    [Parameter] public Guid EmployeeId { get; set; }

    [SupplyParameterFromQuery(Name = "test")]
    public Guid? TestQuery { get; set; }

    private EmployeeCardModel? _card;
    private Guid? _selectedTestId;
    private string? _selectedTestTitle;
    private bool _isLoading = true;
    private bool _isDeleting;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync(TestQuery);
    }

    private async Task ReloadAsync(Guid? selectedTestId)
    {
        _isLoading = true;
        try
        {
            _card = await OrganizationService.GetEmployeeCardAsync(EmployeeId, selectedTestId);
            if (_card is null)
            {
                return;
            }

            _selectedTestId = selectedTestId
                ?? _card.TestTabs.FirstOrDefault()?.TestDocumentId;
            _selectedTestTitle = _card.TestTabs
                .FirstOrDefault(t => t.TestDocumentId == _selectedTestId)?.TestTitle;

            if (_selectedTestId.HasValue && selectedTestId != _selectedTestId)
            {
                _card = await OrganizationService.GetEmployeeCardAsync(EmployeeId, _selectedTestId);
                _selectedTestTitle = _card?.TestTabs
                    .FirstOrDefault(t => t.TestDocumentId == _selectedTestId)?.TestTitle;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectTestAsync(Guid testDocumentId)
    {
        await ReloadAsync(testDocumentId);
    }

    private async Task DeleteEmployeeAsync()
    {
        if (_isDeleting || _card is null)
        {
            return;
        }

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Видалити працівника «{_card.Employee.DisplayName}» разом з усіма тестами та файлами результатів?");

        if (!confirmed)
        {
            return;
        }

        _isDeleting = true;
        _errorMessage = null;
        var departmentId = _card.Department.Id;

        try
        {
            await OrganizationService.DeleteEmployeeAsync(EmployeeId);
            Navigation.NavigateTo($"/admin/departments/{departmentId}");
        }
        catch (Exception ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося видалити працівника."
                : ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task DeleteSessionAsync(EmployeeTestSessionItem session)
    {
        if (_isDeleting)
        {
            return;
        }

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Видалити проходження від {(session.CompletedAt ?? session.StartedAt):dd.MM.yyyy HH:mm}" +
            $"{(session.IsCompleted ? " разом із файлом результату" : "")}?");

        if (!confirmed)
        {
            return;
        }

        _isDeleting = true;
        _errorMessage = null;

        try
        {
            await TestAttemptService.DeleteAsync(session.AttemptId);
            await ReloadAsync(_selectedTestId);
        }
        catch (Exception ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося видалити проходження."
                : ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
