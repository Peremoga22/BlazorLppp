@page "/admin/stukalka"
@page "/stukalka"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Admin)]

@using BlazorLppp.Application.Models
@using BlazorLppp.Domain
@using Microsoft.AspNetCore.Authorization

@inject IStukalkaService StukalkaService
@inject IJSRuntime JsRuntime

<PageTitle>Стукалка</PageTitle>

<div class="admin-page">
    <header class="admin-page__header admin-page__header--hero">
        <div class="admin-page__hero-copy">
            <p class="admin-page__eyebrow">Звернення</p>
            <h1 class="admin-page__title">Стукалка</h1>
            <p class="admin-page__subtitle">
                Залиште повідомлення або перегляньте вхідні звернення
            </p>
        </div>
        <div class="admin-page__hero-meta" aria-hidden="true">
            <span class="admin-page__hero-chip">
                @(_reports.Count == 0 ? "Порожньо" : $"Звернень: {_reports.Count}")
            </span>
        </div>
    </header>

    <section class="admin-panel" aria-labelledby="stukalka-form-heading">
        <h2 id="stukalka-form-heading" class="admin-upload__title">Нове звернення</h2>
        <div class="stukalka-form">
            <label class="stukalka-form__field">
                <span>Автор</span>
                <input class="admin-input"
                       @bind="_author"
                       maxlength="100"
                       placeholder="Порожньо = Анонімно" />
            </label>
            <label class="stukalka-form__field">
                <span>Тема</span>
                <input class="admin-input"
                       @bind="_subject"
                       maxlength="200"
                       placeholder="Коротко, про що звернення" />
            </label>
            <label class="stukalka-form__field stukalka-form__field--wide">
                <span>Текст</span>
                <textarea class="admin-input admin-textarea"
                          @bind="_message"
                          maxlength="4000"
                          placeholder="Опишіть ситуацію"></textarea>
            </label>
            <div class="admin-actions">
                <button type="button"
                        class="admin-btn"
                        disabled="@_isSaving"
                        @onclick="SubmitAsync">
                    Надіслати
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_formMessage))
        {
            <p class="@(_formIsError ? "admin-page__error" : "admin-upload__success")" role="status">
                @_formMessage
            </p>
        }
    </section>

    @if (_isLoading)
    {
        <p class="admin-page__muted">Завантаження...</p>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="admin-page__error" role="alert">@_errorMessage</p>
    }
    else if (_reports.Count == 0)
    {
        <p class="admin-page__muted">Звернень ще немає.</p>
    }
    else
    {
        <section class="admin-upload-list" aria-labelledby="stukalka-list-heading">
            <h2 id="stukalka-list-heading" class="admin-upload__title">Вхідні звернення</h2>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th>Автор</th>
                            <th>Тема</th>
                            <th>Текст</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in _reports)
                        {
                            <tr>
                                <td>@report.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@report.Author</td>
                                <td>@report.Subject</td>
                                <td class="stukalka-table__message">@report.Message</td>
                                <td>
                                    <button type="button"
                                            class="admin-icon-btn admin-icon-btn--danger"
                                            title="Видалити"
                                            aria-label="Видалити"
                                            disabled="@_isDeleting"
                                            @onclick="() => DeleteAsync(report)">
                                        <span class="admin-btn__icon admin-btn__icon--trash" aria-hidden="true"></span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private readonly List<StukalkaReport> _reports = [];
    private string _author = string.Empty;
    private string _subject = string.Empty;
    private string _message = string.Empty;
    private string? _formMessage;
    private bool _formIsError;
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isDeleting;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var items = await StukalkaService.ListAsync();
            _reports.Clear();
            _reports.AddRange(items);
        }
        catch (Exception)
        {
            _errorMessage = "Не вдалося завантажити звернення.";
            _reports.Clear();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;
        _formMessage = null;
        _formIsError = false;

        try
        {
            await StukalkaService.AddAsync(_author, _subject, _message);
            _author = string.Empty;
            _subject = string.Empty;
            _message = string.Empty;
            _formMessage = "Звернення надіслано.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _formIsError = true;
            _formMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося надіслати звернення."
                : ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteAsync(StukalkaReport report)
    {
        if (_isDeleting)
        {
            return;
        }

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Видалити звернення «{report.Subject}»?");

        if (!confirmed)
        {
            return;
        }

        _isDeleting = true;
        _errorMessage = null;

        try
        {
            await StukalkaService.DeleteAsync(report.Id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося видалити звернення."
                : ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
