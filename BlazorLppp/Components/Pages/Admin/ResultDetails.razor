@page "/admin/results/{AttemptId:guid}"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Admin)]

@using BlazorLppp.Application.Models
@using BlazorLppp.Domain
@using Microsoft.AspNetCore.Authorization

@inject ITestAttemptService TestAttemptService
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<PageTitle>Результат тесту</PageTitle>

<div class="admin-page">
    <header class="admin-page__header admin-page__header--hero">
        <div class="admin-page__hero-copy">
            <p class="admin-page__eyebrow">Результат</p>
            <h1 class="admin-page__title">Результат тесту</h1>
            <p class="admin-page__subtitle">Дані працівника та відповіді</p>
        </div>
        <a class="admin-link admin-link--back" href="/admin-home">
            <span class="admin-btn__icon admin-btn__icon--arrow-left" aria-hidden="true"></span>
            До панелі
        </a>
    </header>

    @if (_isLoading)
    {
        <p class="admin-page__muted">Завантаження...</p>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="admin-page__error" role="alert">@_errorMessage</p>
    }
    else if (_details is null)
    {
        <p class="admin-page__muted">Результат не знайдено.</p>
    }
    else
    {
        <dl class="admin-details">
            <div class="admin-details__row">
                <dt>Працівник</dt>
                <dd>@_details.Attempt.LastName @_details.Attempt.FirstName @_details.Attempt.MiddleName</dd>
            </div>
            <div class="admin-details__row">
                <dt>Підрозділ</dt>
                <dd>@_details.Attempt.NumberUnit</dd>
            </div>
            <div class="admin-details__row">
                <dt>Тест</dt>
                <dd>@(_details.TestTitle ?? "—")</dd>
            </div>
            <div class="admin-details__row">
                <dt>Файл</dt>
                <dd>
                    <div class="admin-actions">
                        <code>@($"{_details.FileBaseName}.docx")</code>
                        @if (_details.HasResultFile)
                        {
                            <ResultDownloadLink AttemptId="AttemptId"
                                                CssClass="admin-btn admin-btn--download admin-btn--sm"
                                                Title="Завантажити">
                                <span class="admin-btn__icon admin-btn__icon--download" aria-hidden="true"></span>
                                Завантажити
                            </ResultDownloadLink>
                        }
                        else
                        {
                            <button type="button"
                                    class="admin-btn admin-btn--secondary admin-btn--sm"
                                    @onclick="GenerateAsync">
                                <span class="admin-btn__icon admin-btn__icon--file" aria-hidden="true"></span>
                                Сформувати файл
                            </button>
                        }
                    </div>
                </dd>
            </div>
            <div class="admin-details__row">
                <dt>Завершено</dt>
                <dd>@(_details.Attempt.CompletedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</dd>
            </div>
        </dl>

        <div class="admin-page__actions admin-actions" style="margin-top: 1rem;">
            <button type="button"
                    class="admin-btn admin-btn--danger"
                    disabled="@_isDeleting"
                    @onclick="DeleteAsync">
                <span class="admin-btn__icon admin-btn__icon--trash" aria-hidden="true"></span>
                @(_isDeleting ? "Видалення..." : "Видалити результат")
            </button>
        </div>

        <section class="admin-upload-list" style="margin-top: 1.5rem;">
            <h2 class="admin-upload__title">Відповіді</h2>
            <ol class="admin-preview-list">
                @foreach (var line in _details.Answers)
                {
                    <li class="admin-preview-item">
                        <strong>@line.SortOrder. @line.QuestionText</strong>
                        <div>Відповідь: @line.AnswerText</div>
                    </li>
                }
            </ol>
        </section>
    }
</div>

@code {
    [Parameter]
    public Guid AttemptId { get; set; }

    private TestResultDetails? _details;
    private bool _isLoading = true;
    private bool _isDeleting;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _details = await TestAttemptService.GetResultDetailsAsync(AttemptId);
            if (_details is null)
            {
                _errorMessage = null;
            }
        }
        catch (Exception)
        {
            _details = null;
            _errorMessage = "Не вдалося завантажити результат.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task GenerateAsync()
    {
        try
        {
            await TestAttemptService.EnsureResultFileAsync(AttemptId);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося сформувати файл."
                : ex.Message;
        }
    }

    private async Task DeleteAsync()
    {
        if (_isDeleting || _details is null)
        {
            return;
        }

        var name = $"{_details.Attempt.LastName} {_details.Attempt.FirstName} {_details.Attempt.MiddleName}".Trim();
        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Видалити результат «{name}» разом із файлом на сервері?");

        if (!confirmed)
        {
            return;
        }

        _isDeleting = true;
        _errorMessage = null;

        try
        {
            await TestAttemptService.DeleteAsync(AttemptId);
            NavigationManager.NavigateTo("/admin-home");
        }
        catch (Exception ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося видалити результат."
                : ex.Message;
            _isDeleting = false;
        }
    }
}
