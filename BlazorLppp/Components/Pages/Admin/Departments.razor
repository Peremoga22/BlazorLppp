@page "/admin/departments"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Admin)]

@using BlazorLppp.Application.Models
@using BlazorLppp.Domain
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@inject IOrganizationService OrganizationService
@inject IAnalyticsService AnalyticsService
@inject IJSRuntime JsRuntime

<PageTitle>Підрозділи</PageTitle>

<div class="admin-page">
    <header class="admin-page__header admin-page__header--hero">
        <div class="admin-page__hero-copy">
            <p class="admin-page__eyebrow">Структура організації</p>
            <h1 class="admin-page__title">Підрозділи</h1>
            <p class="admin-page__subtitle">
                Підрозділ → працівник → тест → історія проходжень
            </p>
        </div>
    </header>

    <section class="admin-panel">
        <h2 class="admin-upload__title">Створити підрозділ</h2>
        <div class="admin-form-row">
            <input class="admin-input"
                   @bind="_newDepartmentName"
                   placeholder="Порожньо = наступний (Підрозділ N)" />
            <input class="admin-input admin-input--staff"
                   type="number"
                   min="0"
                   step="1"
                   @bind="_newStaffCount"
                   placeholder="Чисельність"
                   title="Скільки працівників у підрозділі (штат)" />
            <button type="button"
                    class="admin-btn"
                    disabled="@_isSaving"
                    @onclick="CreateDepartmentAsync">
                Додати
            </button>
        </div>
        <p class="admin-page__muted">
            Чисельність (штат) потрібна для коефіцієнта проходження: протестовані працівники / штат.
        </p>
        @if (!string.IsNullOrEmpty(_formMessage))
        {
            <p class="@(_formIsError ? "admin-page__error" : "admin-page__muted")" role="status">@_formMessage</p>
        }
    </section>

    @if (_isLoading)
    {
        <p class="admin-page__muted">Завантаження...</p>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="admin-page__error" role="alert">@_errorMessage</p>
    }
    else if (_departments.Count == 0)
    {
        <p class="admin-empty">Підрозділів ще немає.</p>
    }
    else
    {
        <div class="dept-grid">
            @foreach (var dept in _departments)
            {
                <article class="dept-card">
                    <div class="dept-card__top">
                        <span class="dept-card__number">@dept.Number</span>
                        <button type="button"
                                class="admin-icon-btn admin-icon-btn--danger dept-card__delete"
                                title="Видалити підрозділ"
                                aria-label="Видалити підрозділ"
                                disabled="@_isDeleting"
                                @onclick="() => DeleteDepartmentAsync(dept)"
                                @onclick:stopPropagation="true">
                            <span class="admin-btn__icon admin-btn__icon--trash" aria-hidden="true"></span>
                        </button>
                    </div>
                    <strong class="dept-card__name">@dept.Name</strong>
                    <span class="dept-card__meta">
                        У списку: @dept.EmployeeCount
                        · Штат: @(dept.StaffCount > 0 ? dept.StaffCount.ToString() : "не вказано")
                    </span>
                    @if (CoverageFor(dept.Id) is { } coverage)
                    {
                        <span class="dept-card__meta">
                            Коефіцієнт проходження: @coverage.CompletionRateDisplay
                        </span>
                    }
                    <a class="dept-card__action" href="@($"/admin/departments/{dept.Id}")">Відкрити →</a>
                </article>
            }
        </div>

        <section class="admin-panel analytics-panel">
            <div class="analytics-panel__head">
                <h2 class="admin-upload__title">Аналітика</h2>
                <p class="admin-page__muted">Агреговані показники по організації (без персональних результатів)</p>
            </div>

            @if (_overview is null)
            {
                <p class="admin-page__muted">Завантаження аналітики...</p>
            }
            else
            {
                <div class="analytics-kpi">
                    <article class="analytics-kpi__card">
                        <strong>@_overview.Summary.StaffTotal</strong>
                        <span>Штат</span>
                    </article>
                    <article class="analytics-kpi__card">
                        <strong>@_overview.Summary.EmployeesTotal</strong>
                        <span>У списку</span>
                    </article>
                    <article class="analytics-kpi__card">
                        <strong>@_overview.Summary.EmployeesTested</strong>
                        <span>Протестовано</span>
                    </article>
                    <article class="analytics-kpi__card">
                        <strong>@_overview.Summary.CompletionRateDisplay</strong>
                        <span>Коефіцієнт проходження</span>
                    </article>
                    <article class="analytics-kpi__card">
                        <strong>@_overview.Summary.CompletionsTotal</strong>
                        <span>Тестувань</span>
                    </article>
                    <article class="analytics-kpi__card analytics-kpi__card--attention">
                        <strong>@_overview.Summary.AttentionRequiredEmployees</strong>
                        <span>Потребують уваги</span>
                    </article>
                </div>

                <div class="analytics-split">
                    <div class="analytics-block">
                        <h3 class="analytics-block__title">Коефіцієнт проходження по підрозділах</h3>
                        <ul class="analytics-bars">
                            @foreach (var row in _overview.DepartmentCoverage)
                            {
                                <li class="analytics-bars__item">
                                    <div class="analytics-bars__label">
                                        <a href="@($"/admin/departments/{row.DepartmentId}")">@row.DepartmentName</a>
                                        <span>
                                            @row.EmployeesTested із @(row.StaffCount > 0 ? row.StaffCount : row.EmployeesTotal)
                                            @(row.StaffCount > 0 ? "штату" : "у списку")
                                            · @row.CompletionRateDisplay
                                        </span>
                                    </div>
                                    <div class="analytics-bars__track" aria-hidden="true">
                                        <span class="analytics-bars__fill" style="@($"width:{Math.Clamp(row.BarPercent, 0, 100)}%")"></span>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="analytics-block">
                        <h3 class="analytics-block__title">Пройдені тести</h3>
                        @if (_overview.TestCompletions.Count == 0)
                        {
                            <p class="admin-page__muted">Завершених проходжень ще немає.</p>
                        }
                        else
                        {
                            <ul class="analytics-tests">
                                @foreach (var test in _overview.TestCompletions)
                                {
                                    <li>
                                        <a href="@($"/admin/analytics/tests/{test.TestDocumentId}")">@test.TestTitle</a>
                                        <span>
                                            <strong>@test.Completions</strong> проходжень
                                            · @test.UniqueEmployees працівників
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <div class="analytics-panel__footer">
                    <a class="admin-btn" href="/admin/analytics">Детальна аналітика →</a>
                </div>
            }
        </section>
    }
</div>

@code {
    private readonly List<DepartmentListItem> _departments = [];
    private OrgAnalyticsOverviewDto? _overview;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isDeleting;
    private string? _errorMessage;
    private string? _formMessage;
    private bool _formIsError;
    private string _newDepartmentName = string.Empty;
    private int _newStaffCount;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            await OrganizationService.EnsureDefaultDepartmentsAsync();
            _departments.Clear();
            _departments.AddRange(await OrganizationService.ListDepartmentsAsync());
            _overview = _departments.Count == 0
                ? null
                : await AnalyticsService.GetOrgOverviewAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateDepartmentAsync()
    {
        _isSaving = true;
        _formMessage = null;
        try
        {
            var created = await OrganizationService.CreateDepartmentAsync(_newDepartmentName, _newStaffCount);
            _newDepartmentName = string.Empty;
            _newStaffCount = 0;
            _formIsError = false;
            _formMessage = $"Створено «{created.Name}».";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _formIsError = true;
            _formMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteDepartmentAsync(DepartmentListItem dept)
    {
        if (_isDeleting)
        {
            return;
        }

        var first = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Видалити підрозділ «{dept.Name}»?");

        if (!first)
        {
            return;
        }

        var second = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Підтвердіть ще раз: буде видалено підрозділ «{dept.Name}»" +
            $"{(dept.EmployeeCount > 0 ? $", усіх працівників ({dept.EmployeeCount}) і їхні результати тестів" : "")}." +
            " Цю дію не можна скасувати.");

        if (!second)
        {
            return;
        }

        _isDeleting = true;
        _errorMessage = null;

        try
        {
            await OrganizationService.DeleteDepartmentAsync(dept.Id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося видалити підрозділ."
                : ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private DepartmentCoverageDto? CoverageFor(Guid departmentId)
        => _overview?.DepartmentCoverage.FirstOrDefault(row => row.DepartmentId == departmentId);
}
