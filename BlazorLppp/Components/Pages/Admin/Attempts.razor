@page "/admin/attempts"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Admin)]
@implements IDisposable

@using BlazorLppp.Application.Models
@using BlazorLppp.Domain
@using BlazorLppp.Domain.Enums
@using Microsoft.AspNetCore.Authorization

@inject ITestAttemptService TestAttemptService
@inject IJSRuntime JsRuntime

<PageTitle>Спроби тестування</PageTitle>

<div class="admin-page">
    <header class="admin-page__header">
        <div class="admin-page__header-row">
            <div>
                <h1 class="admin-page__title">Спроби тестування</h1>
                <p class="admin-page__subtitle">Пошук і перегляд усіх записів</p>
            </div>
            <a class="admin-link admin-link--back" href="/admin-home">
                <span class="admin-btn__icon admin-btn__icon--arrow-left" aria-hidden="true"></span>
                До панелі
            </a>
        </div>
    </header>

    <div class="admin-filters">
        <input class="admin-input"
               placeholder="Пошук за ПІБ"
               @bind="_search"
               @bind:event="oninput"
               @bind:after="ReloadAsync" />

        <select class="admin-select" @bind="_statusFilter" @bind:after="OnStatusChangedAsync">
            <option value="">Усі статуси</option>
            <option value="@((int)TestAttemptStatus.InProgress)">В процесі</option>
            <option value="@((int)TestAttemptStatus.Completed)">Завершені</option>
        </select>

        <select class="admin-select"
                @bind="_selectedMonth"
                @bind:after="OnMonthChangedAsync"
                aria-label="Фільтр спроб за місяцем">
            <option value="">Усі місяці</option>
            @foreach (var option in _monthOptions)
            {
                <option value="@option.Value">@option.Label</option>
            }
        </select>
    </div>

    @if (_isLoading)
    {
        <p class="admin-page__muted">Завантаження...</p>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="admin-page__error" role="alert">@_errorMessage</p>
    }
    else if (_result is null || _result.Items.Count == 0)
    {
        <p class="admin-page__muted">@EmptyMessage</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ПІБ</th>
                        <th>Підрозділ</th>
                        <th>Статус</th>
                        <th>Початок</th>
                        <th>Завершення</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _result.Items)
                    {
                        <tr>
                            <td>@item.LastName @item.FirstName @item.MiddleName</td>
                            <td>@item.NumberUnit</td>
                            <td>
                                <span class="admin-badge @(item.Status == TestAttemptStatus.Completed ? "admin-badge--done" : "admin-badge--progress")">
                                    @StatusLabel(item.Status)
                                </span>
                            </td>
                            <td>@item.StartedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(item.CompletedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                            <td>
                                <div class="admin-actions admin-actions--icons">
                                    <a class="admin-icon-btn"
                                       href="@($"/admin/attempts/{item.Id}")"
                                       title="Деталі"
                                       aria-label="Деталі">
                                        <span class="admin-btn__icon admin-btn__icon--eye" aria-hidden="true"></span>
                                    </a>
                                    @if (item.Status == TestAttemptStatus.Completed)
                                    {
                                        <a class="admin-icon-btn admin-icon-btn--download"
                                           href="@($"/admin/results/{item.Id}/download")"
                                           title="Завантажити документ"
                                           aria-label="Завантажити документ">
                                            <span class="admin-btn__icon admin-btn__icon--download" aria-hidden="true"></span>
                                        </a>
                                    }
                                    <button type="button"
                                            class="admin-icon-btn admin-icon-btn--danger"
                                            title="Видалити"
                                            aria-label="Видалити"
                                            disabled="@_isDeleting"
                                            @onclick="() => DeleteAsync(item)">
                                        <span class="admin-btn__icon admin-btn__icon--trash" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admin-pager">
            <button class="admin-btn admin-btn--secondary admin-btn--sm"
                    disabled="@(_result.Page <= 1)"
                    @onclick="() => ChangePageAsync(_result.Page - 1)">
                <span class="admin-btn__icon admin-btn__icon--arrow-left" aria-hidden="true"></span>
                Назад
            </button>
            <span class="admin-page__muted">
                Сторінка @_result.Page з @_result.TotalPages (всього @_result.TotalCount)
            </span>
            <button class="admin-btn admin-btn--secondary admin-btn--sm"
                    disabled="@(_result.Page >= _result.TotalPages)"
                    @onclick="() => ChangePageAsync(_result.Page + 1)">
                Далі
            </button>
        </div>
    }
</div>

@code {
    private TestAttemptListResult? _result;
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private readonly IReadOnlyList<(string Value, string Label)> _monthOptions = MonthFilter.BuildOptions();
    private string _selectedMonth = MonthFilter.CurrentValue;
    private int _page = 1;
    private bool _isLoading = true;
    private bool _isDeleting;
    private string? _errorMessage;
    private CancellationTokenSource? _searchCts;

    private string EmptyMessage
    {
        get
        {
            var option = _monthOptions.FirstOrDefault(o => o.Value == _selectedMonth);
            return string.IsNullOrEmpty(option.Label)
                ? "Спроб не знайдено."
                : $"Спроб за {option.Label.ToLowerInvariant()} не знайдено.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task OnStatusChangedAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task OnMonthChangedAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ReloadAsync()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(300, token);
            _page = 1;
            await LoadAsync(token);
        }
        catch (OperationCanceledException)
        {
            // ignore debounce cancel
        }
    }

    private async Task ChangePageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task DeleteAsync(TestAttempt item)
    {
        if (_isDeleting)
        {
            return;
        }

        var name = $"{item.LastName} {item.FirstName} {item.MiddleName}".Trim();
        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Видалити спробу «{name}»{(item.Status == TestAttemptStatus.Completed ? " разом із файлом результату на сервері" : "")}?");

        if (!confirmed)
        {
            return;
        }

        _isDeleting = true;
        _errorMessage = null;

        try
        {
            await TestAttemptService.DeleteAsync(item.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося видалити спробу."
                : ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task LoadAsync(CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            TestAttemptStatus? status = null;
            if (int.TryParse(_statusFilter, out var statusValue) &&
                Enum.IsDefined(typeof(TestAttemptStatus), statusValue))
            {
                status = (TestAttemptStatus)statusValue;
            }

            _result = await TestAttemptService.GetListAsync(new TestAttemptListQuery
            {
                Search = _search,
                Status = status,
                Month = MonthFilter.Parse(_selectedMonth),
                Page = _page,
                PageSize = 20
            }, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            _errorMessage = "Не вдалося завантажити список спроб.";
            _result = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string StatusLabel(TestAttemptStatus status) => status switch
    {
        TestAttemptStatus.InProgress => "В процесі",
        TestAttemptStatus.Completed => "Завершено",
        _ => status.ToString()
    };

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
