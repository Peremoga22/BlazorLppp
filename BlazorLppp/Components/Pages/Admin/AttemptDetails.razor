@page "/admin/attempts/{AttemptId:guid}"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = AppRoles.Admin)]

@using BlazorLppp.Domain
@using BlazorLppp.Domain.Entities
@using BlazorLppp.Domain.Enums
@using Microsoft.AspNetCore.Authorization

@inject ITestAttemptService TestAttemptService
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<PageTitle>Деталі спроби</PageTitle>

<div class="admin-page">
    <header class="admin-page__header">
        <div class="admin-page__header-row">
            <div>
                <h1 class="admin-page__title">Деталі спроби</h1>
                <p class="admin-page__subtitle">Інформація про респондента та статус</p>
            </div>
            <a class="admin-link admin-link--back" href="/admin/attempts">
                <span class="admin-btn__icon admin-btn__icon--arrow-left" aria-hidden="true"></span>
                До списку
            </a>
        </div>
    </header>

    @if (_isLoading)
    {
        <p class="admin-page__muted">Завантаження...</p>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="admin-page__error" role="alert">@_errorMessage</p>
    }
    else if (_attempt is null)
    {
        <p class="admin-page__muted">Спробу не знайдено.</p>
    }
    else
    {
        <dl class="admin-details">
            <div class="admin-details__row">
                <dt>ID</dt>
                <dd><code>@_attempt.Id</code></dd>
            </div>
            <div class="admin-details__row">
                <dt>Прізвище</dt>
                <dd>@_attempt.LastName</dd>
            </div>
            <div class="admin-details__row">
                <dt>Ім’я</dt>
                <dd>@_attempt.FirstName</dd>
            </div>
            <div class="admin-details__row">
                <dt>По батькові</dt>
                <dd>@_attempt.MiddleName</dd>
            </div>
            <div class="admin-details__row">
                <dt>Підрозділ</dt>
                <dd>@_attempt.NumberUnit</dd>
            </div>
            <div class="admin-details__row">
                <dt>Статус</dt>
                <dd>
                    <span class="admin-badge @(_attempt.Status == TestAttemptStatus.Completed ? "admin-badge--done" : "admin-badge--progress")">
                        @StatusLabel(_attempt.Status)
                    </span>
                </dd>
            </div>
            <div class="admin-details__row">
                <dt>Початок</dt>
                <dd>@_attempt.StartedAt.ToString("dd.MM.yyyy HH:mm:ss")</dd>
            </div>
            <div class="admin-details__row">
                <dt>Завершення</dt>
                <dd>@(_attempt.CompletedAt?.ToString("dd.MM.yyyy HH:mm:ss") ?? "—")</dd>
            </div>
        </dl>

        @if (_attempt.Status == TestAttemptStatus.Completed)
        {
            <div class="admin-page__actions admin-actions">
                <a class="admin-btn" href="@($"/admin/results/{_attempt.Id}")">
                    <span class="admin-btn__icon admin-btn__icon--file" aria-hidden="true"></span>
                    Результат і файл
                </a>
                <button type="button"
                        class="admin-btn admin-btn--danger"
                        disabled="@_isDeleting"
                        @onclick="DeleteAsync">
                    <span class="admin-btn__icon admin-btn__icon--trash" aria-hidden="true"></span>
                    @(_isDeleting ? "Видалення..." : "Видалити")
                </button>
            </div>
        }
        else
        {
            <div class="admin-page__actions admin-actions">
                <button type="button"
                        class="admin-btn admin-btn--danger"
                        disabled="@_isDeleting"
                        @onclick="DeleteAsync">
                    <span class="admin-btn__icon admin-btn__icon--trash" aria-hidden="true"></span>
                    @(_isDeleting ? "Видалення..." : "Видалити спробу")
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid AttemptId { get; set; }

    private TestAttempt? _attempt;
    private bool _isLoading = true;
    private bool _isDeleting;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _attempt = await TestAttemptService.GetByIdAsync(AttemptId);
        }
        catch (Exception)
        {
            _attempt = null;
            _errorMessage = "Не вдалося завантажити спробу.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_isDeleting || _attempt is null)
        {
            return;
        }

        var name = $"{_attempt.LastName} {_attempt.FirstName} {_attempt.MiddleName}".Trim();
        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Видалити спробу «{name}»{(_attempt.Status == TestAttemptStatus.Completed ? " разом із файлом результату на сервері" : "")}?");

        if (!confirmed)
        {
            return;
        }

        _isDeleting = true;
        _errorMessage = null;

        try
        {
            await TestAttemptService.DeleteAsync(AttemptId);
            NavigationManager.NavigateTo("/admin/attempts");
        }
        catch (Exception ex)
        {
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Не вдалося видалити спробу."
                : ex.Message;
            _isDeleting = false;
        }
    }

    private static string StatusLabel(TestAttemptStatus status) => status switch
    {
        TestAttemptStatus.InProgress => "В процесі",
        TestAttemptStatus.Completed => "Завершено",
        _ => status.ToString()
    };
}
