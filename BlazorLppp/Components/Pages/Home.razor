@page "/"
@layout BlazorLppp.Components.Layout.LoginLayout
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Authorization

@inject IJSRuntime JS

<PageTitle>Психологічне тестування</PageTitle>

<div class="chevron-home" @ref="rootRef">
    <div class="chevron-home-text">
        <div class="chevron-home-eyebrow">
            <span class="chevron-home-dot"></span>
            Система психологічного тестування
        </div>
        <h1 class="chevron-home-title">У центрі уваги — людина.</h1>
        <p class="chevron-home-lead">
            Інформаційна система проведення психологічного тестування, обліку результатів
            та оцінювання морально-психологічного стану особового складу.
        </p>
        <div class="chevron-home-actions">
            <a class="chevron-home-cta" href="test/start">Пройти тестування</a>
            <button type="button" class="chevron-home-fullscreen" @onclick="ToggleFullscreen">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" />
                </svg>
                На весь екран
            </button>
        </div>
    </div>

    <div class="chevron-home-visual">
        <div class="chevron-home-canvas-wrap">
            <canvas @ref="canvasRef" class="chevron-home-canvas"></canvas>
        </div>
        <div class="chevron-home-status">
            <span class="chevron-home-dot"></span>
            СИСТЕМА АКТИВНА
        </div>
    </div>
</div>

@code {
    private ElementReference canvasRef;
    private ElementReference rootRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _instance;
    private bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _started || !RendererInfo.IsInteractive)
        {
            return;
        }

        _started = true;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chevron-network.js");
            _instance = await _module.InvokeAsync<IJSObjectReference>(
                "create",
                canvasRef,
                "/images/chevron.png",
                new { nodeCount = 110, maxPulses = 2, darken = 0.32 });
        }
        catch (JSException)
        {
            // Анімація не критична: сторінка лишається робочою без canvas.
        }
    }

    private async Task ToggleFullscreen() => await JS.InvokeVoidAsync("toggleFullscreen", rootRef);

    public async ValueTask DisposeAsync()
    {
        if (_instance is not null)
        {
            try
            {
                await _instance.InvokeVoidAsync("dispose");
                await _instance.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // circuit already gone (навігація/закриття вкладки) — прибирати на клієнті нічого.
            }
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
